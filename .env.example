# Copy to .env.local and fill in. .env.local is gitignored.

# Backend API base URL. Production builds use /api (set in the GitHub workflow).
VITE_API_URL=http://localhost:5046/api

# CARTO basemap key for the Events map: https://carto.com/basemaps/apikey/
# Leave empty to fall back to OpenStreetMap tiles.
VITE_CARTO_KEY=
